{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "skillOverrides": {
    "animate": "user-invocable-only",
    "improve-animations": "user-invocable-only",
    "higgsfield-websites": "user-invocable-only",
    "higgsfield-product-photoshoot": "user-invocable-only",
    "higgsfield-marketplace-cards": "off",
    "higgsfield-youtube-thumbnail": "off",
    "higgsfield-soul-id": "off",
    "higgsfield-video-explainer": "off",
    "higgsfield-brandkit": "off",
    "ask-sonner": "off"
  },

  "permissions": {
    "ask": [
      "Bash(node scripts/screenshot.mjs:*)",
      "Bash(node scripts/screenshot.mjs *)"
    ]
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/route.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
